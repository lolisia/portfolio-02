extends RefCounted
class_name GardenAssets

## Procedural stand-ins for the flowers generated by src/garden.js. The
## Blender nature.glb only contains the base nature meshes, so these small
## low-poly stems and blooms are built here and injected into the builder.

static func build() -> Dictionary:
	var result := {
		"tulipStem": _tulip_stem(),
		"tulipBloom": _tulip_bloom(),
		"lavenderStem": _lavender_stem(),
		"lavenderBloom": _lavender_bloom(),
		"sunflowerStem": _sunflower_stem(),
		"sunflowerBloom": _sunflower_bloom(),
		"sunflowerDisc": _sunflower_disc(),
		"foxgloveStem": _foxglove_stem(),
		"foxgloveBloom": _foxglove_bloom(),
		"roseBloom": _rose_bloom(),
		"flowerStem": _generic_stem(),
		"flowerHead": _generic_head(),
	}
	return result

static func _cylinder(top: float, bottom: float, height: float, segments: int = 6) -> CylinderMesh:
	var mesh := CylinderMesh.new()
	mesh.top_radius = top
	mesh.bottom_radius = bottom
	mesh.height = height
	mesh.radial_segments = segments
	mesh.rings = 1
	return mesh

static func _sphere(radius: float, segments: int = 6, rings: int = 4) -> SphereMesh:
	var mesh := SphereMesh.new()
	mesh.radius = radius
	mesh.height = radius * 2.0
	mesh.radial_segments = segments
	mesh.rings = rings
	return mesh

static func _merge(parts: Array) -> ArrayMesh:
	var tool := SurfaceTool.new()
	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	for part in parts:
		var mesh: Mesh = part[0]
		var transform: Transform3D = part[1]
		for surface in range(mesh.get_surface_count()):
			tool.append_from(mesh, surface, transform)
	return tool.commit()

static func _place(mesh: Mesh, position: Vector3, scale_value: Vector3,
		rotation: Vector3 = Vector3.ZERO) -> Array:
	return [mesh, Transform3D(
		Basis.from_euler(rotation) * Basis.from_scale(scale_value), position)]

static func _leaf(radius: float, position: Vector3, scale_value: Vector3,
		rotation: Vector3) -> Array:
	return _place(_sphere(radius, 5, 3), position, scale_value, rotation)

static func _tulip_stem() -> ArrayMesh:
	var stem := _cylinder(0.009, 0.013, 0.34)
	var parts := [
		_place(stem, Vector3(0, 0.17, 0), Vector3.ONE),
		_leaf(1.0, Vector3(0.035, 0.12, 0.01), Vector3(0.055, 0.018, 0.012), Vector3(0.2, 0.4, 0.5)),
		_leaf(1.0, Vector3(-0.03, 0.18, -0.01), Vector3(0.045, 0.015, 0.010), Vector3(-0.3, 3.4, -0.4)),
	]
	return _merge(parts)

static func _tulip_bloom() -> ArrayMesh:
	var petal := _sphere(0.032, 5, 3)
	var parts := []
	for i in range(6):
		var angle := float(i) * TAU / 6.0
		parts.append(_place(petal,
			Vector3(cos(angle) * 0.018, 0.37, sin(angle) * 0.018),
			Vector3(1.0, 1.7, 0.55),
			Vector3(0.18 * (0.5 if i % 2 == 0 else 1.0), angle, 0.0)))
	return _merge(parts)

static func _lavender_stem() -> ArrayMesh:
	var parts := []
	var stem := _cylinder(0.003, 0.005, 0.34, 4)
	for i in range(5):
		var angle := float(i) * 2.4
		var lean := 0.04 + float(i % 3) * 0.02
		parts.append(_place(stem,
			Vector3(sin(angle) * lean, 0.17, cos(angle) * lean),
			Vector3(1, 0.82 + float(i % 4) * 0.08, 1),
			Vector3(sin(angle) * 0.15, angle, cos(angle) * 0.15)))
	parts.append(_leaf(1.0, Vector3(0.03, 0.08, 0.01), Vector3(0.05, 0.012, 0.01), Vector3(0.1, 0.6, 0.3)))
	parts.append(_leaf(1.0, Vector3(-0.025, 0.1, -0.01), Vector3(0.04, 0.01, 0.01), Vector3(-0.2, 2.6, -0.4)))
	return _merge(parts)

static func _lavender_bloom() -> ArrayMesh:
	var bud := _sphere(0.012, 5, 3)
	var parts := []
	for i in range(5):
		var angle := float(i) * 2.4
		var lean := 0.04 + float(i % 3) * 0.02
		var base := Vector3(sin(angle) * lean, 0.30 + float(i % 4) * 0.02, cos(angle) * lean)
		for k in range(4):
			parts.append(_place(bud,
				base + Vector3(sin(angle) * (0.01 + k * 0.005), 0.01 + k * 0.024, cos(angle) * (0.01 + k * 0.005)),
				Vector3(0.9, 1.5, 0.9)))
	return _merge(parts)

static func _sunflower_stem() -> ArrayMesh:
	var stem := _cylinder(0.014, 0.02, 0.98)
	var parts := [
		_place(stem, Vector3(0, 0.49, 0), Vector3.ONE),
		_leaf(1.0, Vector3(0.11, 0.28, 0.02), Vector3(0.16, 0.016, 0.11), Vector3(0.1, 0.3, 0.35)),
		_leaf(1.0, Vector3(-0.10, 0.46, -0.01), Vector3(0.14, 0.014, 0.10), Vector3(-0.2, 2.6, -0.35)),
		_leaf(1.0, Vector3(0.09, 0.63, 0.01), Vector3(0.12, 0.012, 0.08), Vector3(0.2, 4.6, 0.35)),
		_leaf(1.0, Vector3(-0.07, 0.80, -0.01), Vector3(0.10, 0.012, 0.07), Vector3(-0.2, 1.4, -0.3)),
	]
	return _merge(parts)

static func _sunflower_bloom() -> ArrayMesh:
	var petal := _sphere(0.025, 5, 3)
	var parts := []
	for i in range(16):
		var angle := float(i) * TAU / 16.0
		parts.append(_place(petal,
			Vector3(cos(angle) * 0.11, 1.0, sin(angle) * 0.11),
			Vector3(1.0, 2.3, 0.35),
			Vector3(-0.2, angle + PI * 0.5, 0.0)))
	return _merge(parts)

static func _sunflower_disc() -> ArrayMesh:
	var disc := _cylinder(0.075, 0.08, 0.035, 12)
	var parts := [_place(disc, Vector3(0, 1.0, 0), Vector3.ONE, Vector3(PI * 0.5, 0, 0))]
	return _merge(parts)

static func _foxglove_stem() -> ArrayMesh:
	var stem := _cylinder(0.006, 0.011, 0.62)
	var parts := [
		_place(stem, Vector3(0, 0.31, 0), Vector3.ONE),
		_leaf(1.0, Vector3(0.06, 0.10, 0.02), Vector3(0.09, 0.014, 0.06), Vector3(0.1, 0.4, 0.4)),
		_leaf(1.0, Vector3(-0.05, 0.17, -0.01), Vector3(0.08, 0.012, 0.05), Vector3(-0.1, 2.2, -0.35)),
		_leaf(1.0, Vector3(0.04, 0.24, 0.01), Vector3(0.06, 0.01, 0.04), Vector3(0.1, 4.0, 0.3)),
	]
	return _merge(parts)

static func _foxglove_bloom() -> ArrayMesh:
	var bell := _sphere(0.023, 5, 3)
	var parts := []
	for k in range(12):
		var u := float(k) / 11.0
		var angle := float(k) * 2.2
		parts.append(_place(bell,
			Vector3(sin(angle) * 0.026, 0.34 + u * 0.28, cos(angle) * 0.026),
			Vector3(0.8, 1.4, 0.8) * (1.1 - u * 0.5),
			Vector3(1.1, angle, 0.0)))
	return _merge(parts)

static func _rose_bloom() -> ArrayMesh:
	var petal := _sphere(0.024, 5, 3)
	var parts := []
	for ring in range(3):
		for i in range(5):
			var angle := float(i) * TAU / 5.0 + float(ring) * 0.6
			parts.append(_place(petal,
				Vector3(cos(angle) * (0.01 + ring * 0.018), 0.02 + ring * 0.01,
					sin(angle) * (0.01 + ring * 0.018)),
				Vector3(1.0, 1.0, 0.55),
				Vector3(-0.9 + ring * 0.35, angle, 0.0)))
	return _merge(parts)

static func _generic_stem() -> ArrayMesh:
	var stem := _cylinder(0.005, 0.007, 0.4, 4)
	var parts := [
		_place(stem, Vector3(0, 0.20, 0), Vector3.ONE),
		_leaf(1.0, Vector3(0.025, 0.09, 0.01), Vector3(0.035, 0.01, 0.008), Vector3(0.1, 0.6, 0.3)),
	]
	return _merge(parts)

static func _generic_head() -> ArrayMesh:
	var petal := _sphere(0.018, 5, 3)
	var parts := []
	for i in range(6):
		var angle := float(i) * TAU / 6.0
		parts.append(_place(petal,
			Vector3(cos(angle) * 0.018, 0.41, sin(angle) * 0.018),
			Vector3(1.0, 0.35, 1.0),
			Vector3(0.0, angle, 0.0)))
	return _merge(parts)
